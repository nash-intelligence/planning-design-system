{
  "name": "@nash/planning-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "storybook": "docker compose up --build",
    "storybook:native": "storybook dev -p 6006 --no-open",
    "storybook:down": "docker compose down",
    "build-storybook": "docker buildx build --target storybook-export --output type=local,dest=storybook-static .",
    "build-storybook:native": "storybook build --output-dir storybook-static",
    "verify-storybook": "node scripts/verify-storybook.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "storybook": "10.5.10",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
